<h1><%= @director.first_name %> <%= @director.last_name %>
</h1>
<dl>
  <dt>
    Image
  </dt>
  <dd>
    <img src="<%= @director.image %>" style="width:250px;">
  </dd>

  <dt>
    Dob
  </dt>
  <dd>
    <%= @director.dob %>
  </dd>

  <dt>
    Bio
  </dt>
  <dd>
    <%= @director.bio %>
  </dd>

  <dt>
    Internal ID
  </dt>
  <dd>
    <%= @director.id %>
  </dd>
</dl>
<h2>Filmography</h2>
<ul>
  <% @filmography.each do |movie| %>
    <li>
      <a href="/movies/<%= movie.id %>"><%= movie.title %> (<%= movie.year %>)</a>
    </li>
  <% end %>
</ul>
