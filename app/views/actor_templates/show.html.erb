<h1><%= @actor.first_name %> <%= @actor.last_name %>
</h1>
<dl>
  <dt>
    Image
  </dt>
  <dd>
    <img src="<%= @actor.image %>" style="width:250px;">
  </dd>

  <dt>
    Dob
  </dt>
  <dd>
    <%= @actor.dob %>
  </dd>

  <dt>
    Bio
  </dt>
  <dd>
    <%= @actor.bio %>
  </dd>

  <dt>
    Internal ID
  </dt>
  <dd>
    <%= @actor.id %>
  </dd>
</dl>
<h2>Filmography</h2>
<ul>
  <% @matching_credits.each do |credit| %>
    <% matching_id = credit.movie_id %>
    <% matching_movies = Movie.where({ :id => matching_id }) %>
    <% movie = matching_movies.first %>
    <li>
      <a href="/movies/<%= movie.id %>"><%= movie.title %> (<%= movie.year %>)</a>
    </li>
  <% end %>
</ul>
